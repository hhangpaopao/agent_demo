# deep_pro 环境变量示例：复制为 .env 后填写真实值
# ============ LLM（OpenAI 兼容接口） ============
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ============ Tavily 网络搜索 ============
TAVILY_API_KEY=tvly-xxx

# ============ RAGFlow ============
RAGFLOW_API_KEY=rf-xxx
RAGFLOW_BASE_URL=http://localhost:9380

# ============ 业务数据库（问数 NL2SQL 目标库 / 手写SQL兜底） ============
DW_MYSQL_HOST=localhost
DW_MYSQL_PORT=3306
DW_MYSQL_USER=readonly_user
DW_MYSQL_PASSWORD=xxx
DW_MYSQL_DATABASE=biz_dw

# ============ 问数元数据库（表结构/指标库元数据） ============
META_MYSQL_HOST=localhost
META_MYSQL_PORT=3307
META_MYSQL_USER=root
META_MYSQL_PASSWORD=xxx
META_MYSQL_DATABASE=wenshu_meta

# ============ Qdrant / ES（问数召回使用） ============
# 本地开发填 localhost；docker 部署填服务名（qdrant / elasticsearch）
QDRANT_HOST=localhost
QDRANT_PORT=6333
ES_HOST=localhost
ES_PORT=9200

# ============ Embedding 服务（TEI，见 docker-compose 的 embedding） ============
# 本地开发填 localhost；docker 部署填 embedding
EMBEDDING_HOST=localhost
EMBEDDING_PORT=8081
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024          # 必须与 Qdrant embedding_size 一致，改动需重建索引

# ============ MinIO（用户上传资料的图片存储） ============
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deep-pro
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000

# ============ 业务约束（见计划书 3.1/3.3） ============
SEARCH_MAX_CALLS=5
NL2SQL_MAX_ATTEMPTS=3
UPLOAD_MAX_MB=20
USER_DATASET_TTL_HOURS=24
USER_DATASET_QUOTA_MB=200

# ============ 会话状态持久化（决策7） ============
CHECKPOINT_BACKEND=postgres
CHECKPOINT_PG_DSN=postgresql://deep_pro:deep_pro@localhost:5433/deep_pro

# ============ Redis 缓存 ============
REDIS_URL=redis://localhost:6379/0
